# Skopiuj ten plik jako .env i wpisz swój klucz (console.anthropic.com -> API Keys).
# Plik .env jest w .gitignore, więc nie trafi na GitHuba.
ANTHROPIC_API_KEY=sk-ant-...

# Model agenta. Domyślnie najmocniejszy Opus. Jeśli chcesz taniej testować,
# możesz zmienić na claude-haiku-5-5 (dużo tańszy) albo claude-sonnet-5-5.
F1_AGENT_MODEL=claude-opus-5-5

# Ile maksymalnie rund narzędzi agent może wykonać na jedno pytanie (bezpiecznik).
F1_AGENT_MAX_STEPS=8
